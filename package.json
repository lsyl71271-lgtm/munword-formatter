{
  "name": "pkunmun-2026-docx-formatter",
  "version": "1.8.5",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-web.mjs dev",
    "build": "node scripts/run-web.mjs build",
    "start": "node scripts/run-web.mjs start",
    "build:local-tools": "node scripts/build-local-tools.mjs",
    "build:static": "node scripts/build-static.mjs",
    "build:desktop": "node desktop/build-desktop.mjs --publish",
    "test:desktop": "node --test tests/desktop.test.mjs && node desktop/offline-smoke.mjs",
    "deploy:cloudflare": "wrangler deploy --config wrangler.static.json",
    "test:static": "node --test tests/static-deployment.test.mjs",
    "test": "pnpm test:unit && pnpm build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/docx-safety.test.mjs tests/engine-parity.test.mjs tests/handbook.test.mjs tests/merge-gate.test.mjs tests/studio-tools.test.mjs tests/review-regressions.test.mjs tests/local-web-race.test.mjs tests/audit-regressions.test.mjs tests/countries.test.mjs tests/final-audit.test.mjs tests/template-race.test.mjs tests/dr-numbering.test.mjs tests/all-numbering.test.mjs tests/edge-cases.test.mjs tests/desktop.test.mjs tests/android.test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test:docx-browser": "node --test tests/docx-safety.test.mjs tests/handbook.test.mjs tests/merge-gate.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern static-site",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "docx-preview": "0.4.0",
    "docxtemplater": "3.71.0",
    "drizzle-orm": "0.45.2",
    "fflate": "0.7.5",
    "next": "16.3.6",
    "pizzip": "3.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "jsdom": "26.1.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

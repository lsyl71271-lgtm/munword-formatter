{
  "name": "pkunmun-2026-docx-formatter",
  "version": "1.6.3",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/docx-safety.test.mjs tests/engine-parity.test.mjs tests/handbook.test.mjs tests/merge-gate.test.mjs && vinext build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/docx-safety.test.mjs tests/engine-parity.test.mjs tests/handbook.test.mjs tests/merge-gate.test.mjs",
    "typecheck": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types --config dist/server/wrangler.json worker-configuration.d.ts --include-env false && tsc --noEmit --incremental false",
    "test:docx-browser": "node --test tests/docx-safety.test.mjs tests/handbook.test.mjs tests/merge-gate.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "0.7.5",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "26.1.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

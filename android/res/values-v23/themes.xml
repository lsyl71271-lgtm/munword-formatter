<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 6+: dark status bar icons on the page's light background. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorPrimary">@color/page</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>

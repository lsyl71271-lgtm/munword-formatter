 "subjectLine": {
  "rule": "条款前单独成行、以逗号结尾的机构名称是主体句（如 The Security Council, / 安全理事会，），即使与委员会字段写法不同（带 The、带“联合国”）。以序言或行动动词开头的行不是主体句。",
  "patterns": [
   "The [A-Z][A-Za-z'’.\\-]*(?: (?:[A-Z][A-Za-z'’.\\-]*|of|on|for|and|the|in|to|de|\\([A-Z]+\\))){0,9},",
   "[\\u4e00-\\u9fff·（）()]{0,28}(?:大会|理事会|委员会|议会|组织|会议|法院)[，,]"
  ]
 },
 "language": {
  "rule": "汉字数不少于 minCjk 且不少于拉丁字母数的 1/latinPerCjk 时为中文，否则为英文。英文文件中引用少量汉字（如“一带一路”）仍按英文排版。",
  "minCjk": 2,
  "latinPerCjk": 4
 },

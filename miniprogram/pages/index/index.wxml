<view class="page">
  <view class="hero">
    <view class="eyebrow">PKUNMUN 2026 · 模联文件排版</view>
    <view class="hero-title">让表达，井然有序。</view>
    <view class="hero-sub">选择文件类型，从聊天里选原稿，确认识别结果后生成。文件只在本机处理，不上传。</view>
  </view>

  <view class="stepper">
    <view class="step on">01 类型</view>
    <view class="step {{file ? 'on' : ''}}">02 原稿</view>
    <view class="step {{stage !== 'upload' ? 'on' : ''}}">03 确认</view>
    <view class="step {{stage === 'done' ? 'on' : ''}}">04 生成</view>
  </view>

  <!-- 01 -->
  <view class="card">
    <view class="card-head"><text class="num">01</text><view><view class="h2">选择文件类型</view><view class="hint">为你的文件匹配排版规则</view></view></view>
    <view class="type-grid">
      <view wx:for="{{types}}" wx:key="id" class="type-card {{documentType === item.id ? 'selected' : ''}}" data-type="{{item.id}}" bindtap="onSelectType"
            aria-role="radio" aria-checked="{{documentType === item.id}}" aria-label="{{item.zh}}">
        <text class="badge">{{item.badge}}</text>
        <view class="type-text"><view class="type-zh">{{item.zh}}</view><view class="type-en">{{item.en}}</view></view>
      </view>
    </view>
    <view class="link-row"><text class="link" bindtap="onOpenTemplate">从规范模板新建{{typeName}} ›</text></view>
  </view>

  <!-- 02 -->
  <view class="card">
    <view class="card-head"><text class="num">02</text><view><view class="h2">选择原稿</view><view class="hint">从微信聊天中选择 .docx，最大 20 MB</view></view></view>
    <view class="drop {{file ? 'has-file' : ''}}" bindtap="onChooseFile" aria-role="button" aria-label="{{file ? '重新选择文件，当前为 ' + file.name : '从聊天选择 DOCX 文件'}}">
      <block wx:if="{{file}}">
        <view class="file-name">{{file.name}}</view>
        <view class="hint">{{file.sizeText}} · 点击重新选择</view>
      </block>
      <block wx:else>
        <view class="file-name">从聊天选择文件</view>
        <view class="hint">DOCX 格式 · 文件只在本机处理</view>
      </block>
    </view>
    <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
    <view class="action-row">
      <text class="hint">当前类型 <text class="strong">{{typeName}}</text></text>
      <button class="primary" disabled="{{!file || busy}}" bindtap="onParse">{{busy && stage === 'upload' ? '正在识别…' : '识别文件结构'}}</button>
    </view>
    <view wx:if="{{file}}" class="link-row"><text class="link" bindtap="onPreviewOriginal">预览原稿 ›</text></view>
  </view>

  <!-- 03 -->
  <view wx:if="{{view}}" class="card">
    <view class="card-head"><text class="num">03</text><view><view class="h2">确认识别结果</view><view class="hint">无法可靠判断的字段只提示，由你确认后再生成。</view></view></view>

    <view wx:if="{{view.countries && view.countries.show}}" class="notice">
      <view>国家字段将在生成时自动使用正式全称，无需逐项填写（UNTERM 核对：{{countryDate}}）。正文不会替换；复杂字段保留原样。</view>
      <view wx:for="{{view.countries.changes}}" wx:key="*this">{{item}}</view>
      <view wx:for="{{view.countries.warnings}}" wx:key="*this" class="warn-text">{{item}}</view>
    </view>

    <view class="form">
      <view class="field">
        <view class="label">语言</view>
        <picker mode="selector" range="{{languages}}" range-key="label" value="{{languageIndex}}" bindchange="onLanguageChange">
          <view class="picker">{{languages[languageIndex].label}}</view>
        </picker>
      </view>
      <view wx:for="{{fields}}" wx:key="key" class="field">
        <view class="label">{{item.label}}</view>
        <input class="input" value="{{values[item.key]}}" data-key="{{item.key}}" bindinput="onFieldInput" maxlength="-1" aria-label="{{item.label}}" />
      </view>
    </view>

    <view wx:if="{{view.warnings.length}}" class="warnings">
      <view class="strong">需要确认</view>
      <view wx:for="{{view.warnings}}" wx:key="*this">△ {{item}}</view>
    </view>

    <view class="structure">
      <view class="structure-head"><text class="strong">格式化结构</text><text class="hint">识别摘要，非页面排版</text></view>
      <view class="doc-title">{{view.title}}</view>
      <view wx:for="{{view.summary}}" wx:key="label" class="summary"><text class="strong">{{item.label}}</text>{{item.value}}</view>
      <view wx:for="{{view.clauses}}" wx:key="key" class="clause level{{item.level}} {{item.kind}}">
        <text class="mark">{{item.mark}}</text><text class="clause-text">{{item.text}}</text><text class="confidence">{{item.confidence}}%</text>
      </view>
      <view wx:if="{{view.clauseTotal > view.clauses.length}}" class="hint">仅显示前 {{view.clauses.length}} 条，共 {{view.clauseTotal}} 条。</view>
    </view>

    <view class="link-row"><text class="link" bindtap="onToggleDiagnostics">{{showDiagnostics ? '收起识别依据' : '识别依据与诊断'}} ›</text></view>
    <view wx:if="{{showDiagnostics}}" class="diagnostics">
      <view>已识别 {{view.paragraphCount}} 个非空段落、{{view.clauseTotal}} 个正文或条款。规则置信值不是格式正确率。</view>
      <view wx:if="{{view.missing}}">待确认字段：{{view.missing}}</view>
      <view wx:for="{{view.clauses}}" wx:key="key" class="diag-row">第 {{item.paragraph}} 段 · {{item.kind}} / {{item.level + 1}} · {{item.reason}}</view>
    </view>

    <view class="options">
      <view wx:if="{{keepsSourceName}}" class="hint">成稿文件名沿用上传的原文件名：<text class="strong">{{file.name}}</text></view>
      <block wx:else>
        <view class="field"><view class="label">提交会期</view><input class="input" placeholder="例如：第三会期 / S3" value="{{options.sessionLabel}}" data-key="sessionLabel" bindinput="onOptionInput" maxlength="-1" /></view>
        <view class="field"><view class="label">{{treaty ? '文件名中的签署方' : '提交国家'}}</view><input class="input" placeholder="用于文件名" value="{{options.submittingCountry}}" data-key="submittingCountry" bindinput="onOptionInput" maxlength="-1" /></view>
        <view class="field"><view class="label">版本号</view><input class="input" value="{{options.version}}" data-key="version" bindinput="onOptionInput" maxlength="-1" /></view>
      </block>
      <block wx:if="{{!treaty}}">
        <view class="switch-row"><text>按规则规范条款末尾标点</text><switch checked="{{options.normalizePunctuation}}" data-key="normalizePunctuation" bindchange="onOptionSwitch" color="#1788bc" /></view>
        <view class="switch-row"><text>高级：保持国家原顺序</text><switch checked="{{options.preserveOrder}}" data-key="preserveOrder" bindchange="onOptionSwitch" color="#1788bc" /></view>
      </block>
    </view>
    <button class="primary wide" disabled="{{busy}}" bindtap="onGenerate">{{busy ? '正在生成…' : '生成 DOCX'}}</button>
  </view>

  <!-- 04 -->
  <view wx:if="{{validations.length}}" id="result" class="card">
    <view class="card-head"><text class="num">04</text><view><view class="h2">{{result ? '成稿已生成' : '格式校验结果'}}</view><view class="hint">语义不确定项只给出提示，不自动改写。</view></view></view>
    <view wx:if="{{result}}" class="result">
      <view class="file-name">{{result.filename}}</view>
      <view class="result-actions">
        <button class="secondary" bindtap="onOpenResult">预览</button>
        <button class="secondary" bindtap="onShareResult">发送到聊天</button>
        <button class="secondary" bindtap="onSaveResult">保存</button>
      </view>
      <view class="hint">预览页右上角菜单也可以转发或用其他应用打开。字体和分页以 Word / WPS 为准。</view>
    </view>
    <view wx:for="{{validations}}" wx:key="key" class="validation {{item.status}}">
      <text class="v-icon">{{item.icon}}</text>
      <view><view class="strong">{{item.label}}</view><view wx:if="{{item.detail}}" class="hint">{{item.detail}}</view></view>
    </view>
  </view>

  <view class="footer">
    <text class="link" bindtap="onOpenAbout">关于与隐私</text>
    <view class="hint">依据 PKUNMUN 2026 学标示例排版；保留正文、图片、引用与可编辑编号。</view>
  </view>
</view>

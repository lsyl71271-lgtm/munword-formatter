<view class="page">
  <view class="card">
    <view class="h2">从规范模板新建文件</view>
    <view class="hint">独立于原稿排版。使用所选文种和学标规则，不生成或改写正文。每段一行，条款编号请按需要填写。</view>
    <view class="field">
      <view class="label">文件类型</view>
      <picker mode="selector" range="{{types}}" range-key="zh" value="{{typeIndex}}" bindchange="onTypeChange"><view class="picker">{{types[typeIndex].zh}}</view></picker>
    </view>
    <view class="field">
      <view class="label">语言</view>
      <picker mode="selector" range="{{languages}}" range-key="label" value="{{languageIndex}}" bindchange="onLanguageChange"><view class="picker">{{languages[languageIndex].label}}</view></picker>
    </view>
    <view wx:for="{{fields}}" wx:key="key" class="field">
      <view class="label">{{item.label}}</view>
      <input class="input" value="{{input[item.key]}}" data-key="{{item.key}}" bindinput="onInput" maxlength="-1" aria-label="{{item.label}}" />
    </view>
    <view class="field">
      <view class="label">正文</view>
      <textarea class="textarea" value="{{input.body}}" data-key="body" bindinput="onInput" maxlength="-1" auto-height="{{true}}" placeholder="填写正文，不会调用 AI 或上传云端" />
    </view>
    <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
    <button class="primary wide" disabled="{{busy}}" bindtap="onGenerate">{{busy ? '正在生成…' : '生成规范 DOCX'}}</button>
  </view>

  <view wx:if="{{result}}" class="card result">
    <view class="strong">已生成：{{result.filename}}</view>
    <view class="actions">
      <button class="secondary" bindtap="onOpenResult">预览</button>
      <button class="secondary" bindtap="onShareResult">发送到聊天</button>
      <button class="secondary" bindtap="onSaveResult">保存</button>
    </view>
  </view>
</view>

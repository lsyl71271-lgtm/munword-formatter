/* Shared look: the web version's blue accent on WeChat's light grey page. */
page {
  --accent: #1788bc;
  --accent-soft: #e8f4fa;
  --ink: #10202c;
  --muted: #5f6f7b;
  --line: #dbe4ea;
  --card: #ffffff;
  --ok: #1f7a3a;
  --warn: #9a6700;
  --bad: #b3261e;
  background: #f4f8fb;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}
.page { padding: 24rpx 32rpx 64rpx; box-sizing: border-box; }
.card { background: var(--card); border-radius: 20rpx; padding: 32rpx; margin-top: 24rpx; border: 1rpx solid var(--line); }
.card-head { display: flex; align-items: flex-start; margin-bottom: 24rpx; }
.num { margin-right: 20rpx; font-weight: 700; color: var(--accent); font-size: 28rpx; padding-top: 4rpx; }
.h2 { font-size: 34rpx; font-weight: 600; }
.hint { color: var(--muted); font-size: 26rpx; }
.strong { font-weight: 600; color: var(--ink); }
.link-row { margin-top: 20rpx; }
.link { color: var(--accent); font-size: 28rpx; }
.error { margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 12rpx; background: #fdecea; color: var(--bad); font-size: 28rpx; }
.form, .options { margin-top: 8rpx; }
.field { margin-top: 20rpx; }
.label { font-size: 26rpx; color: var(--muted); margin-bottom: 8rpx; }
.input, .picker, .textarea { border: 1rpx solid var(--line); border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 30rpx; background: #fbfdfe; min-height: 44rpx; }
.textarea { width: auto; min-height: 280rpx; }
button.primary { background: var(--accent); color: #fff; font-size: 30rpx; font-weight: 600; border-radius: 14rpx; margin: 0; padding: 0 36rpx; line-height: 84rpx; }
button.primary[disabled] { background: #9cc8dc !important; color: #fff !important; }
button.primary.wide { width: 100%; margin-top: 32rpx; }
button.secondary { background: var(--accent-soft); color: var(--accent); font-size: 28rpx; border-radius: 14rpx; margin: 0; line-height: 76rpx; padding: 0 24rpx; }
button::after { border: none; }
.footer { margin-top: 40rpx; text-align: center; }
.footer .hint { margin-top: 8rpx; }

+/* UTF-16 name to UTF-8 (the inverse of ASCIIToUnicode). */
 char* unicodeToAscii(HFSUniStr255* str) {
   int i;
   char* toReturn;
+  unsigned char* out;
   
-  toReturn = (char*) malloc(sizeof(char) * (str->length + 1));
+  toReturn = (char*) malloc(sizeof(char) * (str->length * 3 + 1));
+  out = (unsigned char*) toReturn;
   
   for(i = 0; i < str->length; i++) {
-    toReturn[i] = (char)(str->unicode[i] & 0xff);
+    uint32_t cp = str->unicode[i];
+    if(cp >= 0xD800 && cp < 0xDC00 && i + 1 < str->length && str->unicode[i + 1] >= 0xDC00 && str->unicode[i + 1] < 0xE000) {
+      cp = 0x10000 + ((cp - 0xD800) << 10) + (str->unicode[i + 1] - 0xDC00);
+      i++;
+    }
+    if(cp < 0x80) {
+      *out++ = cp;
+    } else if(cp < 0x800) {
+      *out++ = 0xC0 | (cp >> 6);
+      *out++ = 0x80 | (cp & 0x3F);
+    } else if(cp < 0x10000) {
+      *out++ = 0xE0 | (cp >> 12);
+      *out++ = 0x80 | ((cp >> 6) & 0x3F);
+      *out++ = 0x80 | (cp & 0x3F);
+    } else {
+      *out++ = 0xF0 | (cp >> 18);
+      *out++ = 0x80 | ((cp >> 12) & 0x3F);
+      *out++ = 0x80 | ((cp >> 6) & 0x3F);
+      *out++ = 0x80 | (cp & 0x3F);
+    }
   }
-  toReturn[i] = '\0';
+  *out = '\0';
   
   return toReturn;
 }

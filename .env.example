# Optional browser API override. Blank = browser-only DOCX processing.
# NEXT_PUBLIC variables are visible to users: NEVER put secrets here.
NEXT_PUBLIC_API_URL=

# Optional QA/installer settings: export these in the shell when needed.
# These Python scripts do not automatically read this dotenv file.
# MUNWORD_FIXTURE_ROOT=/path/to/private/fixtures
# MUNWORD_DOCX_RENDERER=/path/to/render_docx.py
# MUNWORD_QA_FONTCONFIG=/path/to/fontconfig.xml
# MUNWORD_QA_CAIRO=/path/to/pdftocairo
# MUNWORD_REGRESSION_OUTPUT=/path/to/generated/output
# PKUNMUN_PORT=8000
# PKUNMUN_NO_BROWSER=1
